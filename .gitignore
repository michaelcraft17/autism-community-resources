# Working files from tools/npi_taxonomy_*.py — regenerate with the pipeline
# in tools/npi_taxonomy_fetch.py's docstring, never commit these (some run into
# the hundreds of MB).
tools/npi_scratch/

# Same deal for tools/cqc_uk_fetch.py -- the raw CQC directory CSV is ~19MB and
# regenerable (the script re-downloads it if missing).
tools/cqc_scratch/

# Same deal for tools/wikidata_autism_fetch.py -- entities.json is a raw re-fetchable cache.
tools/wikidata_scratch/

# Same deal for tools/france_rna_fetch.py -- raw_records.json is a raw re-fetchable cache.
tools/france_rna_scratch/

# Generic catch-all so future tools/<name>_scratch/ dirs don't need a new line here.
tools/*_scratch/

# Local-only debug map for eyeballing newly-merged pins before/after a merge -- not part
# of the site, regenerate with: see conversation history for the diff-and-copy steps.
tools/preview/

# Timestamped run logs from tools/scheduled_refresh.sh -- local operational noise, not
# part of the project.
tools/logs/

# Harvest outputs from tools/cqc_uk_fetch.py, tools/wikidata_autism_fetch.py, and the
# GPT-Researcher pipeline, already merged into community_resources.json via
# tools/merge_new_resources.py. Left on disk for reference but not tracked -- rerun the
# relevant tool to regenerate any of them.
new_resources_*.json

# Aider (local-LLM coding agent) runtime files. Aider re-appends the blanket ".aider*"
# line on every run if it's missing (its own first-run behavior) -- the negation below
# keeps .aider.conf.yml tracked regardless. Also passing --no-gitignore in the launcher
# script so it stops touching this file at all.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
.aider*
!.aider.conf.yml
__pycache__/
